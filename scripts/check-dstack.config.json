  "routes": {
    "externalCommands": [
      "plugin",
      "loop",
      "help",
      "clear",
      "compact",
      "config",
      "model",
      "agents"
    ],
    "ignoreCommandPattern": "^(verify-|[a-z]+-mode$)"
  },
  "ps1": {
    "requireAscii": true,
    "requireCrlf": true,
    "requiredLines": [
      "^#Requires -Version 5\\.1\\s*$",
      "^Set-StrictMode -Version Latest\\s*$",
      "^\\$ErrorActionPreference = 'Stop'\\s*$"
    ],
    "denylist": [
      {
        "pattern": "&&",
        "why": "pipeline chain operator is PowerShell 7+"
      },
      {
        "pattern": "\\|\\|",
        "why": "pipeline chain operator is PowerShell 7+"
      },
      {
        "pattern": "\\?\\?",
        "why": "null-coalescing is PowerShell 7+"
      },
      {
        "pattern": "\\?\\.",
        "why": "null-conditional is PowerShell 7+"
      },
      {
        "pattern": "\\?\\s+[^:\\n]+\\s+:\\s",
        "why": "ternary is PowerShell 7+"
      },
      {
        "pattern": "-Parallel\\b",
        "why": "ForEach-Object -Parallel is PowerShell 7+"
      },
      {
        "pattern": "\\$Is(Windows|MacOS|Linux)\\b",
        "why": "automatic variable is PowerShell 6+"
      },
      {
        "pattern": "\\$PSStyle\\b",
        "why": "PowerShell 7.2+"
      },
      {
        "pattern": "-AsHashtable\\b",
        "why": "ConvertFrom-Json -AsHashtable is PowerShell 6+"
      },
      {
        "pattern": "utf8NoBOM|utf8BOM",
        "why": "encoding names are PowerShell 6+"
      },
      {
        "pattern": "\\b(Out-File|Set-Content|Add-Content)\\b",
        "why": "5.1 default encodings differ; write through [System.IO.File] with an explicit UTF8Encoding($false)"
      },
      {
        "pattern": "(^|[^2>])>>?\\s*[\\$\\w\"']",
        "why": "redirection writes UTF-16 in 5.1; write through [System.IO.File]"
      },
      {
        "pattern": "\\bGet-Error\\b|\\bJoin-String\\b|\\bConvertFrom-Markdown\\b",
        "why": "cmdlet does not exist in Windows PowerShell 5.1"
      }
    ],
    "fenceDenylist": [
      {
        "pattern": "&&",
        "why": "not valid in Windows PowerShell 5.1"
      },
      {
        "pattern": "\\|\\|",
        "why": "not valid in Windows PowerShell 5.1"
      }
    ]
  },
  "language": {
