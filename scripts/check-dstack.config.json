    {
      "id": "SHELL",
      "scope": "all",
      "flags": "",
      "patterns": [
        "^#!.*\\b(ba|z)?sh\\b",
        "```(bash|sh|zsh)\\b",
        "\\b[\\w-]+\\.sh\\b",
        "(^|[\\s`\"'(])/tmp/",
